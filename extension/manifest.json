{
  "manifest_version": 3,
  "name": "TradeGuard — Pre-Trade Discipline Checklist",
  "version": "1.2.1",
  "description": "Zero-API pre-trade checklist gatekeeper that prevents emotional impulse orders and unplanned position exits on web trading terminals.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TradeGuard Rules"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dhan.co/*",
        "https://kite.zerodha.com/*",
        "https://*.tradingview.com/*",
        "https://pro.upstox.com/*",
        "https://tv.upstox.com/*",
        "https://trade.fyers.in/*",
        "https://trade.angelone.in/*",
        "https://www.angelone.in/trade/*",
        "https://web.sensibull.com/*",
        "https://ant.aliceblueonline.com/*",
        "https://trade.paytmmoney.com/*"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
