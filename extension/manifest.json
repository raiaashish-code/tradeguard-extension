{
  "manifest_version": 3,
  "name": "TradeGuard — Pre-Trade Discipline Checklist",
  "version": "1.2.3",
  "description": "Zero-API pre-trade checklist gatekeeper that prevents emotional impulse orders and unplanned position exits strictly on web trading terminals.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TradeGuard Rules"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/chart/*",
        "https://*.dhan.co/*",
        "https://*.scanx.trade/*",
        "https://kite.zerodha.com/*",
        "https://pro.upstox.com/*",
        "https://tv.upstox.com/*",
        "https://trade.fyers.in/*",
        "https://tv.fyers.in/*",
        "https://*.fyers.in/*",
        "https://groww.in/stocks/*",
        "https://groww.in/futures-and-options/*",
        "https://groww.in/indices/*",
        "https://groww.in/commodities/*",
        "https://*.sahi.com/*",
        "https://*.icicidirect.com/*",
        "https://*.sbisecurities.in/*",
        "https://*.sbismart.com/*",
        "https://trade.angelone.in/*",
        "https://www.angelone.in/trade/*",
        "https://*.kotaksecurities.com/*",
        "https://*.hdfcsky.com/*",
        "https://*.hdfcsec.com/*",
        "https://*.motilaloswal.com/*",
        "https://*.5paisa.com/*",
        "https://*.aliceblueonline.com/*",
        "https://*.paytmmoney.com/*",
        "https://*.sensibull.com/*",
        "https://*.shoonya.com/*",
        "https://*.flattrade.in/*",
        "https://*.mstock.com/*",
        "https://*.sharekhan.com/*",
        "https://*.samco.in/*",
        "https://*.axisdirect.in/*",
        "https://*.definedge.com/*",
        "https://*.delta.exchange/*",
        "https://*.coindcx.com/*"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
