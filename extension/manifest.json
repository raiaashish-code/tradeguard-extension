{
  "manifest_version": 3,
  "name": "TradeGuard — Pre-Trade Discipline Checklist",
  "version": "1.1.0",
  "description": "Zero-API pre-trade checklist gatekeeper that prevents emotional impulse orders and unplanned position exits.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TradeGuard Rules"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
